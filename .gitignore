# The game — never commit anything from the disc or made from the game's code
/disc/
/game/
/generated/
*.chd
*.iso
*.bin
# ...except the standard cage's climbing animations (the cage match: standard/cage/, shipped)
!/standard/cage/animations/*.bin
# ...and the standard wrestlers' moves (standard/moves/, shipped: their animations and eye tracks)
!/standard/moves/**/*.bin
*.elf
SLUS_*
*.p2s
# memory cards the runtime creates, pictures of the game
/mc0/
/mc1/
/shots/
# mods: animations and other content converted from games (yours, never committed)
/mods/
# projects: each one's list of mods and its own memory cards (yours, never committed)
/projects/

# generated config (tools/make_config.py) — the inputs in config/ are committed
config/vendetta.toml
config/vendetta_functions.csv

# logs, runtime UI state, caches
/logs/
*.log
imgui.ini
# the player's settings (the game writes a default one)
settings.toml
# the settings program's build output
/settings-app/bin/
/settings-app/obj/
__pycache__/
*.pyc

# OS
Thumbs.db
.DS_Store
# release zips (make-release.bat)
/dist/
