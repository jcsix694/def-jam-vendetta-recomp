<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VendettaSettings.ViewModels"
             x:Class="VendettaSettings.Views.ModsView"
             x:DataType="vm:ModsViewModel">
    <UserControl.Styles>
        <!-- a mod that stops the project from starting: outlined, its line in yellow -->
        <Style Selector="Border.modrow.bad">
            <Setter Property="Background" Value="#2e2a20" />
            <Setter Property="BorderBrush" Value="{StaticResource VWarn}" />
        </Style>
        <Style Selector="TextBlock.badline">
            <Setter Property="Foreground" Value="{StaticResource VWarn}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.neededline">
            <Setter Property="Foreground" Value="#c9a85a" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="26,20,26,16" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
        <!-- the heading, and the project shown -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <TextBlock Classes="h1" Text="Mods" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="key" Text="Project" VerticalAlignment="Center" IsVisible="{Binding HasProject}" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding ProjectNames}" SelectedItem="{Binding ForProject}" MinWidth="180"
                      IsVisible="{Binding HasProject}" />
            <TextBlock Grid.Column="2" Classes="hint" VerticalAlignment="Center" IsVisible="{Binding NoProject}"
                       Text="No projects yet: make one on the Play page." />
        </Grid>

        <!-- mods come from the mod kit -->
        <Border Grid.Row="1" Classes="modrow" Padding="12,6" IsVisible="{Binding HasProject}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="Mods are added with the mod kit." Foreground="{StaticResource VText2}" VerticalAlignment="Center" FontSize="13" />
                <Button Grid.Column="1" Classes="outline small" Content="Open this project's mods folder" Command="{Binding OpenProjectModsCommand}" />
                <Button Grid.Column="2" Classes="outline small" BorderBrush="{StaticResource VAccent}" Content="Open the mod kit" Command="{Binding OpenModKitCommand}" />
            </Grid>
        </Border>

        <!-- the list's heading: the counts, and how many need fixing -->
        <Border Grid.Row="2" BorderBrush="{StaticResource VLine}" BorderThickness="0,0,0,1" Padding="0,4,0,7" IsVisible="{Binding HasProject}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Classes="cap" Text="{Binding ListHeading}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding BadText}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource VWarn}"
                           VerticalAlignment="Center" IsVisible="{Binding HasBad}" />
                <TextBox Grid.Column="2" Text="{Binding Search}" Watermark="Search" Width="160" Height="28" MinHeight="28" FontSize="13"
                         Padding="8,4" VerticalContentAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="8">
            <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryChip">
                        <Button Classes="chipbtn" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding Pick}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="note" Classes.warn="{Binding NoteIsWarning}" IsVisible="{Binding HasNote}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="outline small" Content="Turn both off" Command="{Binding OffBothCommand}" IsVisible="{Binding AskOff}" />
                    <Button Grid.Column="2" Classes="outline small" Content="Keep it on" Command="{Binding KeepOnCommand}" IsVisible="{Binding AskOff}" />
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel Spacing="6">
                <!-- a project with no mods -->
                <StackPanel Spacing="12" Margin="0,40,0,0" HorizontalAlignment="Center" IsVisible="{Binding ListEmpty}">
                    <TextBlock Text="{Binding EmptyText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Classes="hint" Text="It plays as the original game until then." HorizontalAlignment="Center" />
                    <Button Classes="accent" Content="Open the mod kit" Command="{Binding OpenModKitCommand}" HorizontalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="hint" IsVisible="{Binding NothingMatches}" Margin="2,6" Text="No mods match." />

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModRow">
                            <Border Classes="modrow" Classes.bad="{Binding IsBad}" Padding="12,8">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                    <ToggleSwitch IsChecked="{Binding IsOn, Mode=OneWay}" Command="{Binding Toggle}" OnContent="" OffContent=""
                                                  MinWidth="0" VerticalAlignment="Center" IsEnabled="{Binding IsInstalled}" ToolTip.Tip="{Binding ToggleTip}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#f0f0f2" />
                                            <Border Classes="placetag" IsVisible="{Binding IsInstalled}"><TextBlock Text="{Binding Kind}" /></Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Line}" FontSize="12.5" Classes="muted" Classes.badline="{Binding IsBad}" Classes.neededline="{Binding IsNeeded}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="outline small" BorderBrush="{StaticResource VWarn}" Content="{Binding FixText}"
                                            Command="{Binding Fix}" IsVisible="{Binding HasFix}" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Classes="outline arrow" Command="{Binding Up}" IsEnabled="{Binding CanUp}" ToolTip.Tip="Load it earlier" VerticalAlignment="Center">
                                        <PathIcon Width="10" Height="6" Data="M0,6 L5,0 L10,6 Z" />
                                    </Button>
                                    <Button Grid.Column="4" Classes="outline arrow" Command="{Binding Down}" IsEnabled="{Binding CanDown}" ToolTip.Tip="Load it later" VerticalAlignment="Center">
                                        <PathIcon Width="10" Height="6" Data="M0,0 L10,0 L5,6 Z" />
                                    </Button>
                                    <Button Grid.Column="5" Classes="outline arrow" Command="{Binding Remove}" IsEnabled="{Binding IsInstalled}" VerticalAlignment="Center"
                                            ToolTip.Tip="Remove from this project" Foreground="#ff8a80">
                                        <PathIcon Width="11" Height="12" Data="M1,3 L10,3 M3.5,3 L3.5,1 L7.5,1 L7.5,3 M2,3 L2.7,11 L8.3,11 L9,3" Foreground="#ff8a80" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="hint" Margin="2,4" TextWrapping="Wrap" IsVisible="{Binding HasProject}"
                           Text="Lower down wins when two mods change the same thing." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
