<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VendettaSettings.ViewModels"
             x:Class="VendettaSettings.Views.ModDialog"
             x:DataType="vm:ModsViewModel">
    <!-- over the whole window: Remove from this project -->
    <Border Background="#8c000000">
        <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22" CornerRadius="10"
                Background="{StaticResource VPanel}" BorderBrush="{StaticResource VLine}" BorderThickness="1"
                BoxShadow="0 18 50 0 #80000000">
            <StackPanel Spacing="12">
                <TextBlock Classes="h1" FontSize="17" Text="{Binding RemoveTitle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RemoveWarning}" TextWrapping="Wrap" Foreground="{StaticResource VText2}" IsVisible="{Binding RemoveHasWarning}" />
                <TextBlock Classes="hint" Text="{Binding RemoveText}" TextWrapping="Wrap" />
                <TextBlock Classes="bad" Text="{Binding DialogError}" TextWrapping="Wrap" IsVisible="{Binding DialogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="outline" Content="Cancel" Command="{Binding CancelDialogCommand}" />
                    <Button Classes="redfill" Content="{Binding RemoveConfirmText}" Command="{Binding ConfirmDialogCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
