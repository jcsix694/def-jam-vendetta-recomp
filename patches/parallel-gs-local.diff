+void GSInterface::set_host_image(uint32_t id, uint32_t width, uint32_t height, std::vector<uint32_t> rgba)
+{
+	if (!id || !width || !height || rgba.size() != size_t(width) * height)
+		return;
+	std::lock_guard<std::mutex> holder(host_image_lock);
+	host_image_pending.push_back({ id, width, height, std::move(rgba) });
+}
+
+void GSInterface::drop_host_image(uint32_t id)
+{
+	std::lock_guard<std::mutex> holder(host_image_lock);
+	host_image_pending.push_back({ id, 0, 0, {} });
+}
+
+void GSInterface::drain_host_images()
+{
+	std::vector<PendingHostImage> pending;
+	{
+		std::lock_guard<std::mutex> holder(host_image_lock);
+		pending.swap(host_image_pending);
+	}
+	for (auto &image : pending)
+	{
+		if (image.rgba.empty())
+			host_images.erase(image.id);
+		else
+			host_images[image.id] = renderer.create_host_image(image.width, image.height, image.rgba.data());
+	}
+}
+
+void GSInterface::a_d_HOSTIMAGE(uint64_t payload)
+{
+	drain_host_images();
+	host_image_armed_tbp = uint32_t(payload & 0x3fffu);
+	host_image_armed_id = uint32_t(payload >> 32);
+}
+
+void GSInterface::a_d_HOSTBIND(uint64_t payload)
+{
+	// Binds (or with id 0 unbinds) at once, with no transfer: for the program's own draws, which bind their image
+	// around their primitives and unbind it after, so the game's texture at that address is untouched.
+	drain_host_images();
+	uint32_t tbp = uint32_t(payload & 0x3fffu);
+	uint32_t id = uint32_t(payload >> 32);
+	if (id)
+		host_image_bound[tbp] = id;
+	else
+		host_image_bound.erase(tbp);
+	state_tracker.last_texture_descriptor = {};
+	state_tracker.dirty_flags |= STATE_DIRTY_TEX_BIT | STATE_DIRTY_PRIM_TEMPLATE_BIT;
+}
+
+void GSInterface::host_image_transfer(uint32_t dbp)
+{
+	if (dbp == host_image_armed_tbp)
+	{
+		if (host_image_armed_id)
+			host_image_bound[dbp] = host_image_armed_id;
+		else
+			host_image_bound.erase(dbp);
+		host_image_armed_tbp = UINT32_MAX;
+	}
+	else if (!host_image_bound.empty())
+		host_image_bound.erase(dbp);
+}
+
+uint32_t GSInterface::use_host_image(const TextureDescriptor &desc, const Vulkan::ImageHandle &image)
+{
+	// Normalised by the GS texture's own rect, not the image's size: the image lines up in every coordinate and
+	// wrap mode, whatever its size.
+	TextureInfo info = {};
+	info.view = &image->get_view();
+	info.info.sizes = vec4(float(1u << uint32_t(desc.tex0.desc.TW)), float(1u << uint32_t(desc.tex0.desc.TH)),
+	                       1.0f / float(desc.rect.width), 1.0f / float(desc.rect.height));
+	info.info.region.x = desc.clamp.desc.WMS == CLAMPBits::REGION_CLAMP ? float(uint32_t(desc.clamp.desc.MINU)) : 0.0f;
+	info.info.region.z = desc.clamp.desc.WMS == CLAMPBits::REGION_CLAMP ? float(uint32_t(desc.clamp.desc.MAXU))
+	                                                                     : float(desc.rect.width) - 1.0f;
+	info.info.region.y = desc.clamp.desc.WMT == CLAMPBits::REGION_CLAMP ? float(uint32_t(desc.clamp.desc.MINV)) : 0.0f;
+	info.info.region.w = desc.clamp.desc.WMT == CLAMPBits::REGION_CLAMP ? float(uint32_t(desc.clamp.desc.MAXV))
+	                                                                     : float(desc.rect.height) - 1.0f;
+	info.info.bias.x = -float(desc.rect.x) * info.info.sizes.z;
+	info.info.bias.y = -float(desc.rect.y) * info.info.sizes.w;
+	info.info.arrayed = 0;
+	// An image larger than the GS texture is HD art: the shader picks its mip level from the triangle's footprint.
+	// One at the GS texture's own size is sampled exactly as the GS samples the texture.
+	info.info.flags = image->get_width() > desc.rect.width || image->get_height() > desc.rect.height ? TEX_INFO_HOST_HD : 0;
+
+	uint32_t texture_index = render_pass.tex_infos.size();
+	render_pass.tex_infos.push_back(info);
+	render_pass.tex0_infos.push_back(desc.tex0.desc);
+	render_pass.held_images.push_back(image);
+
+	// The next draw with this same descriptor may be a game texture again: never match it.
+	state_tracker.last_texture_descriptor = {};
+	state_tracker.last_texture_index = texture_index;
+	state_tracker.last_texture_index_valid_at_texflush = state_tracker.texflush_counter;
+	state_tracker.texflush_counter_pending = false;
+	return texture_index;
+}
